# Copy this file to .env and fill in real values. Never commit .env to version control.

# --- Core ---
# Full PostgreSQL connection string (must match POSTGRES_* vars below)
DATABASE_URL=postgresql+psycopg2://<db_user>:<db_password>@localhost:5432/<db_name>

# JWT signing secret — generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=<generate-a-strong-random-secret>
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000

# --- PostgreSQL (used by docker-compose) ---
POSTGRES_USER=<db_user>
POSTGRES_PASSWORD=<db_password>
POSTGRES_DB=<db_name>

# --- Seed script ---
# Password for the seeded demo users (dev/staging only, never use in production)
SEED_PASSWORD=<choose-a-seed-password>

# --- Dodo Payments (optional) ---
# If unset, the Dodo adapter falls back to MockDodoProvider and all events are
# tagged source_mode=SIMULATED. Never leave real secrets in this file.
DODO_API_KEY=
DODO_WEBHOOK_SECRET=

# --- TensorMux / inference routing (optional) ---
# If unset, InferenceRouter uses local rule-based routing + templated explanations.
TENSORMUX_API_KEY=
# Optional real model call for AI explanation text (falls back to template if unset).
ANTHROPIC_API_KEY=

# --- AO orchestration (optional) ---
# No public AO SDK is wired in; app/integrations/ao is a local implementation of
# the same worker/case interface AO could later be dropped behind.
AO_API_KEY=

# --- Neatlogs-style observability (optional) ---
# app/integrations/neatlogs is a local trace/span recorder (writes to Postgres).
# Set these only if/when exporting to a real Neatlogs backend.
NEATLOGS_API_KEY=
NEATLOGS_PROJECT=

# --- Object storage ---
OBJECT_STORE_PATH=./data/object_store
